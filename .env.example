# 复制为 .env.local 后修改，改完需重启 dev server

# 默认音乐源：audius | jamendo | netease | qq（页面上也可以随时切换）
VITE_MUSIC_PROVIDER=netease

# --- Jamendo（CC 正版曲库，官方 API）---
# 在 https://devportal.jamendo.com/ 申请 client_id；未配置时不出现在切换列表
# VITE_JAMENDO_CLIENT_ID=

# --- 网易云（NeteaseCloudMusicApiEnhanced）---
# 以 / 开头：pnpm dev / pnpm preview 会自动启动项目自带的 API 服务并代理到该路径
# 也可以填自部署服务的完整地址，例如 https://ncm.example.com
# 配置后即使当前音乐源是 audius，网易云也会作为额外的歌词源参与择优
VITE_NETEASE_API_BASE=/ncm
# 自带 API 服务监听的本地端口
NETEASE_API_PORT=3000

# --- QQ 音乐（@yakult-green-tea/qq-music-api，非官方接口）---
# 以 / 开头时由 dev / preview 服务拉起自带的 API 服务并代理；也可以填自部署地址
# 取播放链接基本都需要扫码登录（顶栏 [LOGIN]），登录态保存在 API 服务的 .auth-state 目录
# 未配置时 QQ 音乐不出现在切换列表
# VITE_QQ_API_BASE=/qq
# QQ_API_PORT=3200
